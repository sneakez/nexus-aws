          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"{{runPrefix}}:postman\",\n  \"orderNumber\": \"{{runPrefix}}-postman\",\n  \"customerId\": null,\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"tax\": 0,\n  \"shippingFee\": 30000,\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"unitPrice\": 100000\n    }\n  ]\n}",
          "options": {
