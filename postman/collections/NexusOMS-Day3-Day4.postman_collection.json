{
  "info": {
    "name": "NexusOMS Day 3–4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real API contract checks. Requires products/warehouse with stock and manager/warehouse tokens. No credentials are saved in this file."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{managerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5155"
    }
  ],
  "item": [
    {
      "name": "01 No token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create and reserve",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"{{runPrefix}}:postman\",\n  \"orderNumber\": \"{{runPrefix}}-postman\",\n  \"customerId\": null,\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"tax\": 0,\n  \"shippingFee\": 30000,\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"unitPrice\": 100000\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const order = pm.response.json(); pm.environment.set(\"orderId\", order.id); pm.environment.set(\"itemId\", order.items[0].id);",
              "pm.test(\"Calculated total and snapshot\", () => { const o=pm.response.json(); pm.expect(o.total).to.eql(230000); pm.expect(o.items[0].unitCost).to.eql(60000); });",
              "pm.test(\"Location header\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/orders/\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Replay create",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/orders",
        "header": [
          {
