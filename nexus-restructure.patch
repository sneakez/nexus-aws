-
-@keyframes dialog-fade-out {
-  from {
-    opacity: 1;
-    transform: scale(1) translateY(0);
-  }
-  to {
-    opacity: 0;
-    transform: scale(0.95) translateY(-0.5rem);
-  }
-}
-
-/* Native popover animations using @starting-style */
-[popover] {
-  transition:
-    opacity 0.2s,
-    transform 0.2s,
-    display 0.2s allow-discrete;
-  opacity: 0;
-  transform: scale(0.95);
