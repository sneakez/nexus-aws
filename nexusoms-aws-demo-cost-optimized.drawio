<mxfile host="Electron" agent="Codex">
  <diagram id="nexusoms-demo-cost-optimized" name="Demo cost-optimized architecture">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="NexusOMS — AWS Demo Architecture (Cost Optimized)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#232f3e;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="880" height="42" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Mục tiêu: trình diễn luồng React → .NET API → Supabase với chi phí thấp; không phải cấu hình production HA." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="37" y="62" width="1000" height="30" as="geometry" /></mxCell>
        <mxCell id="demo-note" value="DEMO: 1 Fargate task • Không NAT Gateway • Không Route 53 • Không WAF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#ff9900;fontColor=#8a4b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="28" width="590" height="43" as="geometry" /></mxCell>

        <mxCell id="user" value="Người dùng&#xa;Browser" style="shape=mxgraph.basic.person;fillColor=#4b7bec;strokeColor=#2d5ea8;fontColor=#1b365d;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="70" height="70" as="geometry" /></mxCell>
        <mxCell id="dns" value="Cloudflare / DNS nhà cung cấp domain&#xa;DNS miễn phí (thay Route 53)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fa;strokeColor=#7d8fa4;fontColor=#34495e;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="165" y="300" width="190" height="90" as="geometry" /></mxCell>

        <mxCell id="region" value="AWS Region — ap-southeast-1 (Singapore)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00a1c9;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontColor=#007eb9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="410" y="115" width="1070" height="760" as="geometry" /></mxCell>

        <mxCell id="cloudfront" value="Amazon CloudFront&#xa;CDN + HTTPS" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="175" width="75" height="75" as="geometry" /></mxCell>
        <mxCell id="s3" value="Amazon S3&#xa;React/Vite build" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="175" width="75" height="75" as="geometry" /></mxCell>
        <mxCell id="acm" value="AWS Certificate Manager&#xa;TLS certificate" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775" y="175" width="75" height="75" as="geometry" /></mxCell>

        <mxCell id="vpc" value="VPC — Demo network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8c4fff;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingTop=9;spacingLeft=12;fontColor=#6b38b6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="450" y="330" width="805" height="430" as="geometry" /></mxCell>
        <mxCell id="public-a" value="Public subnet A&#xa;Availability Zone A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8e9;strokeColor=#7aa116;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontColor=#4b7000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="375" width="345" height="340" as="geometry" /></mxCell>
        <mxCell id="public-b" value="Public subnet B&#xa;Availability Zone B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8e9;strokeColor=#7aa116;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontColor=#4b7000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="375" width="350" height="340" as="geometry" /></mxCell>
        <mxCell id="alb" value="Application Load Balancer&#xa;HTTPS API endpoint&#xa;spans 2 public subnets" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="430" width="85" height="85" as="geometry" /></mxCell>
        <mxCell id="ecs" value="Amazon ECS on Fargate&#xa;1 .NET NexusOMS API task&#xa;Public IP; inbound only from ALB" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_container_service;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1005" y="510" width="90" height="90" as="geometry" /></mxCell>
        <mxCell id="igw" value="Internet Gateway&#xa;Outbound: Supabase, ECR, CloudWatch" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="85" height="70" as="geometry" /></mxCell>

        <mxCell id="ecr" value="Amazon ECR&#xa;Docker image" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_container_registry;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="400" width="85" height="75" as="geometry" /></mxCell>
        <mxCell id="ssm" value="SSM Parameter Store&#xa;Supabase config + secrets" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="540" width="85" height="75" as="geometry" /></mxCell>
        <mxCell id="cloudwatch" value="Amazon CloudWatch&#xa;API logs + error metrics" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="680" width="85" height="75" as="geometry" /></mxCell>
        <mxCell id="iam" value="IAM Roles&#xa;least privilege" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="680" width="85" height="75" as="geometry" /></mxCell>

        <mxCell id="supabase" value="Supabase Cloud — outside AWS VPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5fffb;strokeColor=#3ecf8e;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingTop=9;spacingLeft=12;fontColor=#16875d;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1520" y="320" width="325" height="350" as="geometry" /></mxCell>
        <mxCell id="supabase-auth" value="Supabase Auth&#xa;JWT + roles" style="shape=mxgraph.basic.lock;fillColor=#3ecf8e;strokeColor=#16875d;fontColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1580" y="405" width="70" height="70" as="geometry" /></mxCell>
        <mxCell id="supabase-db" value="Supabase PostgreSQL&#xa;business data" style="shape=cylinder;fillColor=#3ecf8e;strokeColor=#16875d;fontColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1710" y="405" width="70" height="70" as="geometry" /></mxCell>
        <mxCell id="supabase-storage" value="Supabase Storage&#xa;future files" style="shape=mxgraph.basic.folder;fillColor=#dff8ea;strokeColor=#16875d;fontColor=#145a3e;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1645" y="545" width="70" height="70" as="geometry" /></mxCell>

        <mxCell id="cost-note" value="Chi phí demo 24/7 ước lượng: ~34–38 USD/tháng + thuế.&#xa;Tắt ECS khi không demo; xóa ALB sau buổi demo để tránh chi phí giờ chạy.&#xa;Không dùng NAT Gateway: Fargate public IP nhưng Security Group chỉ nhận traffic từ ALB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#4ba3d9;fontColor=#1a5375;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="455" y="790" width="990" height="65" as="geometry" /></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="user" target="dns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#5f6b7a;" /><mxCell id="e2" edge="1" parent="1" source="dns" target="cloudfront" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#5f6b7a;" /><mxCell id="e3" edge="1" parent="1" source="cloudfront" target="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#5f6b7a;" /><mxCell id="e4" edge="1" parent="1" source="cloudfront" target="alb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#5f6b7a;" /><mxCell id="e5" edge="1" parent="1" source="acm" target="cloudfront" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#5f6b7a;" /><mxCell id="e6" edge="1" parent="1" source="alb" target="ecs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#5f6b7a;" /><mxCell id="e7" edge="1" parent="1" source="ecs" target="supabase-auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#16875d;" /><mxCell id="e8" edge="1" parent="1" source="ecs" target="supabase-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#16875d;" /><mxCell id="e9" edge="1" parent="1" source="ecr" target="ecs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#5f6b7a;" /><mxCell id="e10" edge="1" parent="1" source="ssm" target="ecs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#5f6b7a;" /><mxCell id="e11" edge="1" parent="1" source="ecs" target="cloudwatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#5f6b7a;" /><mxCell id="e12" edge="1" parent="1" source="iam" target="ecs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#5f6b7a;" />
      </root>
    </mxGraphModel>
